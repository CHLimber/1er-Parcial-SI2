DATABASE_URL=postgresql://fashionstore:fashionstore@localhost:5433/fashionstore
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# CU10 - subida de imagenes de catalogo (app/core/media.py + POST .../imagenes/subir).
# PUBLIC_BASE_URL es la URL con la que ESTE backend se ve desde afuera (la usa para armar la URL
# publica de cada imagen guardada en /media); en Railway es la URL publica del servicio backend.
# MEDIA_DIR es la carpeta donde se guardan los archivos (montada como volumen en docker-compose).
PUBLIC_BASE_URL=http://localhost:8081
MEDIA_DIR=media

# CU06 - Stripe (pasarela real, modo test). Conseguir las claves en
# https://dashboard.stripe.com/test/apikeys ; el webhook secret sale de
# `stripe listen --forward-to localhost:8081/pagos/webhook/stripe`
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CU18 - asistente de chat (app/modules/asistente/). Conseguir la clave en
# https://console.anthropic.com/settings/keys . Sin esta variable /asistente/chat responde 503.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
